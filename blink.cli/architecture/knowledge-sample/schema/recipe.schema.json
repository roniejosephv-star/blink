{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tinkr.build/schemas/recipe.schema.json",
  "title": "Tinkr Knowledge Base — Recipe",
  "description": "A multi-step workflow that works.",
  "type": "object",
  "required": ["type", "name", "description", "steps"],
  "additionalProperties": false,
  "properties": {
    "type": { "const": "recipe" },
    "id": { "type": "string", "pattern": "^recipe/[a-z0-9][a-z0-9-]*[a-z0-9]$" },
    "name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "description": { "type": "string", "minLength": 20 },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Free-form tags for discovery (e.g., ['esp32', 'micropython', 'beginner'])."
    },
    "setup": {
      "type": "object",
      "properties": {
        "requires_plugin": { "type": "string", "description": "Plugin name and version range (e.g., 'tinkr-esp32@^1.2')." },
        "requires_device_family": { "type": "string" },
        "requires_firmware": { "type": "string" }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "run"],
        "properties": {
          "name": { "type": "string", "description": "Human-readable step name." },
          "run": { "type": "string", "description": "CLI command (with optional args) or MCP tool name." },
          "args": {
            "type": "object",
            "description": "Arguments to pass. Values can be templated with $capture_var.field or $input.name.",
            "additionalProperties": true
          },
          "capture": { "type": "string", "description": "Variable name to store the result in for later steps." },
          "if": { "type": "string", "description": "Optional conditional (e.g., '$chip.family == \"esp32s3\"')." },
          "on_error": { "type": "string", "enum": ["abort", "continue", "retry"], "default": "abort" }
        }
      }
    },
    "contributed_by": { "type": "string" },
    "contributed_at": { "type": "string", "format": "date-time" }
  }
}
