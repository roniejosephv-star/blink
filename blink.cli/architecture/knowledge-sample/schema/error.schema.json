{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tinkr.build/schemas/error.schema.json",
  "title": "Tinkr Knowledge Base — Error",
  "description": "A known error and its likely fixes.",
  "type": "object",
  "required": ["type", "error_code", "summary", "likely_causes", "fix_steps"],
  "additionalProperties": false,
  "properties": {
    "type": { "const": "error" },
    "id": {
      "type": "string",
      "pattern": "^error/[a-z0-9][a-z0-9-]*[a-z0-9]$"
    },
    "category": {
      "enum": [
        "i2c", "spi", "uart", "i2s", "wifi", "ble",
        "flash", "repl", "filesystem", "import", "memory",
        "power", "ota", "boot", "general"
      ]
    },
    "error_code": {
      "type": "string",
      "description": "The actual error code or pattern (e.g., 'OSError_ETIMEDOUT' or 'ImportError_no_module_named_machine'). Use snake_case for machine-matchable codes; freeform is also OK for human-recognized patterns."
    },
    "summary": { "type": "string", "maxLength": 200, "minLength": 10 },
    "likely_causes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["summary"],
        "properties": {
          "fact_id": { "type": "string", "description": "Optional reference to a fact in the KB." },
          "summary": { "type": "string", "maxLength": 300 }
        }
      }
    },
    "fix_steps": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 10 },
      "description": "Ordered list of steps to fix the error. The first step is the most likely fix."
    },
    "verify_steps": {
      "type": "array",
      "items": { "type": "string" },
      "description": "How to confirm the fix worked."
    },
    "contributed_by": { "type": "string" },
    "contributed_at": { "type": "string", "format": "date-time" },
    "verified_at": { "type": "string", "format": "date" }
  }
}
