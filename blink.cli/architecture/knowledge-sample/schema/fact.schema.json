{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tinkr.build/schemas/fact.schema.json",
  "title": "Tinkr Knowledge Base — Fact",
  "description": "An atomic fact about a chip, electrical spec, register map, or hardware quirk.",
  "type": "object",
  "required": ["type", "category", "summary", "detail", "sources"],
  "additionalProperties": false,
  "properties": {
    "type": { "const": "fact" },
    "id": {
      "type": "string",
      "description": "Globally unique ID, e.g., 'fact/esp32-s3-i2c-pullups'",
      "pattern": "^fact/[a-z0-9][a-z0-9-]*[a-z0-9]$"
    },
    "category": {
      "enum": [
        "hardware-quirk",
        "electrical-spec",
        "register-map",
        "voltage-level",
        "current-limit",
        "timing",
        "protocol-detail",
        "firmware-quirk",
        "wiring-pattern"
      ]
    },
    "summary": { "type": "string", "maxLength": 200, "minLength": 10 },
    "detail": { "type": "string", "minLength": 50 },
    "chips": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Chip families this fact applies to. Use the canonical family ID (e.g., 'esp32s3', 'rp2040')."
    },
    "related_errors": {
      "type": "array",
      "items": { "type": "string" },
      "description": "References to error IDs in the KB (e.g., 'error/i2c-timeout')."
    },
    "related_patterns": {
      "type": "array",
      "items": { "type": "string" },
      "description": "References to pattern IDs in the KB."
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "format": "uri" },
      "description": "At least one citation (datasheet URL, app note, official doc)."
    },
    "verified_at": {
      "type": "string",
      "format": "date",
      "description": "When this fact was last verified against a primary source."
    },
    "contributed_by": { "type": "string", "description": "Handle of the contributor." },
    "contributed_at": { "type": "string", "format": "date-time" }
  }
}
